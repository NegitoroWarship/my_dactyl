#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            bindings = <
                /*  1     2     3     4     5     6        7     8     9     0     -       =       \| */
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6    &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSLH

                /* Tab    Q     W     E     R     T          Y     U     I     O     P       [       ] */
                &kp TAB &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P    &kp LBKT &kp RBKT

                /* Ctrl   A     S     D     F     G          H     J     K     L     ;       '       Enter */
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G      &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER

                /* Shift  Z     X     C     V     B          N     M     ,       .       /       Up      Shift */
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp UP &kp RSHFT

                /* Left thumbs: Meta->Win, Alt, Super->Space.  Right thumb row. */
                &kp LGUI &kp LALT &kp SPACE                   &kp BSPC &kp DEL &kp ESC &kp GRAVE &kp LEFT &kp DOWN &kp RIGHT

                /* Right single-key row: momentary Function layer. */
                &mo 1
            >;
        };

        function_layer {
            display-name = "Function";

            bindings = <
                /* Func+1..0 -> F1..F10; Func+-/= -> F11/F12. */
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6    &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans

                /* Func+Q/W/E/R/T select Bluetooth host profiles 1..5. */
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                                                               &trans &trans &trans &trans &trans &trans &trans

                /* R2: 13 transparent bindings. */
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans

                /* Func+B clears the bond for the currently selected host profile. */
                &trans &trans &trans &trans &trans &bt BT_CLR
                                                               &trans &trans &trans &trans &trans &trans &trans

                /* Func+Esc -> Print Screen at Esc's new right-thumb position. */
                &trans &trans &trans                         &trans &trans &kp PSCRN &trans &trans &trans &trans

                /* The held bottom-right Func key remains transparent. */
                &trans
            >;
        };
    };
};
